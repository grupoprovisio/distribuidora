name: Provisio five-module browser E2E
on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: provisio-e2e-${{ github.ref }}
  cancel-in-progress: true
jobs:
  browser-auth-rls-storage:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    env:
      NEXT_TELEMETRY_DISABLED: '1'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: '24'
          cache: npm
      - run: npm ci
      - name: Verify local-only guard and MFA QR regressions
        run: npm run test:local-config && npm run test:mfa-qr && npm run test:uuid
      - name: Install Chromium
        run: npx playwright install --with-deps chromium
      - name: Start disposable Supabase (no hosted credentials)
        run: npm run test:e2e:start
      - name: Real browser, Auth, MFA, Storage and transaction tests
        run: npm run test:e2e
      - name: Produce redacted evidence summary
        if: always()
        run: npm run test:e2e:report
      - name: Save non-sensitive evidence only
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: provisio-five-module-evidence
          path: |
            test-results/e2e-safe-summary.json
            test-results/**/produto-webp-privado.png
            test-results/**/comprador-entrega-concluida.png
            test-results/**/*-pedidos-mobile.png
          if-no-files-found: warn
          retention-days: 14
      - name: Stop the disposable local stack
        if: always()
        run: npm run test:e2e:stop
