{
  "name": "provisio-distribuidora",
  "version": "0.1.0",
  "description": "Marketplace B2B híbrido Grupo Provisio: catálogo comercial autorizado, compradores empresariais, fornecedores homologados e gestão segura.",
  "keywords": [
    "provisio",
    "distribuidora",
    "marketplace-b2b",
    "comprador",
    "fornecedor",
    "abastecimento",
    "atacado",
    "catalogo-autorizado",
    "nextjs",
    "react",
    "typescript",
    "supabase",
    "tailwindcss"
  ],
  "homepage": "https://grupoprovisio.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grupoprovisio/distribuidora.git"
  },
  "bugs": {
    "url": "https://github.com/grupoprovisio/distribuidora/issues"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:marketplace": "node scripts/marketplace-domain-check.mjs && node scripts/marketplace-access-check.mjs && node scripts/marketplace-csv-check.mjs && node scripts/marketplace-order-check.mjs && node scripts/marketplace-operations-check.mjs && node scripts/marketplace-finance-check.mjs && npm run test:hardening",
    "test:hardening": "node --test scripts/marketplace-hardening-check.mjs",
    "test:supabase-foundation": "node --test scripts/marketplace-supabase-gateway-check.mjs",
    "test:frontend-scope": "node --test scripts/marketplace-frontend-scope-check.mjs && node scripts/marketplace-project-progress-check.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
